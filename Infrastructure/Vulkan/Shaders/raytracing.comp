#version 450

layout (local_size_x = 16, local_size_y = 16) in;
layout (binding = 0, rgba8) uniform writeonly image2D outputImage;

layout (binding = 1) uniform CameraUBO {
    vec3 position;
    float _pad1;
    vec3 target;
    float _pad2;
    vec2 resolution;
    float time;
    float fov;
} camera;

shared vec3 s_camPos;
shared vec3 s_camForward;
shared vec3 s_camRight;
shared vec3 s_camUp;
shared float s_tanHalfFov;
shared float s_aspectRatio;

struct Triangle {
    vec3 v0;
    float pad0;
    vec3 v1;
    float pad1;
    vec3 v2;
    float pad2;
    vec3 color;
    float pad3;
};

layout (std140, binding = 2) readonly buffer TriangleSSBO {
    Triangle triangles[];
};

struct Light {
    int type;
    float intensity;
    float pad1;
    float pad2;
    float posX;
    float posY;
    float posZ;
    float pad3;
    float dirX;
    float dirY;
    float dirZ;
    float pad4;
    float colorR;
    float colorG;
    float colorB;
    float pad5;
};

layout (std430, binding = 3) buffer LightUBO {
    int numLights;
    int _pad1;
    int _pad2;
    int _pad3;
    Light lights[8];
} lighting;

layout (binding = 4) uniform RenderSettings {
    int maxBounces;
    int enableShadows;
    int enableReflections;
    float reflectionStrength;
    int shadowSamples;
    float shadowSoftness;
    vec2 _pad;
} settings;

struct BvhNode {
    vec3 boundsMin;
    int leftChild;
    vec3 boundsMax;
    int rightChild;
    int triangleStart;
    int triangleCount;
    int pad0;
    int pad1;
};

layout (std430, binding = 5) readonly buffer BvhSSBO {
    BvhNode bvhNodes[];
};

struct Ray {
    vec3 origin;
    vec3 direction;
};

struct Hit {
    bool hit;
    float dist;
    vec3 point;
    vec3 normal;
    vec3 color;
};

const float EPSILON = 0.01;
const float BACKFACE_EPSILON = 1e-6;
const float MAX_DIST = 100.0;
const float SHADOW_BIAS = EPSILON * 10.0;
const float SPECULAR_POWER = 32.0;
const float SHADOW_AMBIENT = 0.2;
const float GAMMA = 1.5;

Hit intersectTriangle(Ray ray, Triangle tri) {
    Hit h;
    h.hit = false;

    vec3 e1 = tri.v1 - tri.v0;
    vec3 e2 = tri.v2 - tri.v0;
    vec3 pvec = cross(ray.direction, e2);
    float det = dot(e1, pvec);

    if (det < BACKFACE_EPSILON) return h;

    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - tri.v0;
    float u = dot(tvec, pvec) * invDet;

    if (u < 0.0 || u > 1.0) return h;

    vec3 qvec = cross(tvec, e1);
    float v = dot(ray.direction, qvec) * invDet;

    if (v < 0.0 || u + v > 1.0) return h;

    float t = dot(e2, qvec) * invDet;

    if (t > EPSILON) {
        h.hit = true;
        h.dist = t;
        h.point = ray.origin + ray.direction * t;
        h.normal = normalize(cross(e1, e2));
        h.color = tri.color;
    }

    return h;
}

Hit intersectTriangleShadow(Ray ray, Triangle tri) {
    Hit h;
    h.hit = false;

    vec3 e1 = tri.v1 - tri.v0;
    vec3 e2 = tri.v2 - tri.v0;
    vec3 pvec = cross(ray.direction, e2);
    float det = dot(e1, pvec);

    if (det > -BACKFACE_EPSILON) return h;

    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - tri.v0;
    float u = dot(tvec, pvec) * invDet;

    if (u < 0.0 || u > 1.0) return h;

    vec3 qvec = cross(tvec, e1);
    float v = dot(ray.direction, qvec) * invDet;

    if (v < 0.0 || u + v > 1.0) return h;

    float t = dot(e2, qvec) * invDet;

    if (t > EPSILON) {
        h.hit = true;
        h.dist = t;
    }

    return h;
}

bool intersectAABB(vec3 origin, vec3 invDir, vec3 boxMin, vec3 boxMax, float tMax) {
    vec3 t0s = (boxMin - origin) * invDir;
    vec3 t1s = (boxMax - origin) * invDir;

    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger = max(t0s, t1s);

    float tmin = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    float tmax = min(min(tbigger.x, tbigger.y), tbigger.z);

    return tmax >= max(tmin, 0.0) && tmin < tMax;
}

Hit traceBVH(Ray ray) {
    Hit closest;
    closest.hit = false;
    closest.dist = MAX_DIST;

    int numNodes = bvhNodes.length();
    if (numNodes == 0) {
        return closest;
    }

    vec3 invDir = 1.0 / ray.direction;

    int stack[64];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        BvhNode node = bvhNodes[nodeIdx];

        if (!intersectAABB(ray.origin, invDir, node.boundsMin, node.boundsMax, closest.dist)) {
            continue;
        }

        if (node.triangleCount > 0) {
            for (int i = 0; i < node.triangleCount; i++) {
                int triIdx = node.triangleStart + i;
                Hit h = intersectTriangle(ray, triangles[triIdx]);
                if (h.hit && h.dist < closest.dist) {
                    closest = h;
                }
            }
        } else {
            if (node.rightChild >= 0) {
                stack[stackPtr++] = node.rightChild;
            }
            if (node.leftChild >= 0) {
                stack[stackPtr++] = node.leftChild;
            }
        }
    }

    return closest;
}

bool traceShadowBVH(vec3 origin, vec3 lightDir, float maxDist) {
    if (settings.enableShadows == 0) {
        return false;
    }

    int numNodes = bvhNodes.length();
    if (numNodes == 0) {
        return false;
    }

    vec3 invDir = 1.0 / lightDir;

    int stack[32];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        BvhNode node = bvhNodes[nodeIdx];

        if (!intersectAABB(origin, invDir, node.boundsMin, node.boundsMax, maxDist)) {
            continue;
        }

        if (node.triangleCount > 0) {
            Ray shadowRay;
            shadowRay.origin = origin;
            shadowRay.direction = lightDir;

            for (int i = 0; i < node.triangleCount; i++) {
                int triIdx = node.triangleStart + i;
                Hit h = intersectTriangleShadow(shadowRay, triangles[triIdx]);
                if (h.hit && h.dist < maxDist) {
                    return true;
                }
            }
        } else {
            if (node.leftChild >= 0) {
                stack[stackPtr++] = node.leftChild;
            }
            if (node.rightChild >= 0) {
                stack[stackPtr++] = node.rightChild;
            }
        }
    }

    return false;
}


vec3 calculateAmbientLight(vec3 albedo, Light light) {
    vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);
    return albedo * lightColor * light.intensity;
}

vec3 calculateDirectionalLight(vec3 albedo, vec3 normal, vec3 viewDir, vec3 hitPoint, Light light) {
    vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);
    vec3 lightDir = vec3(light.dirX, light.dirY, light.dirZ);
    vec3 lDir = normalize(-lightDir);

    float diff = max(dot(normal, lDir), 0.0);

    bool inShadow = traceShadowBVH(hitPoint + normal * SHADOW_BIAS, lDir, MAX_DIST);
    float shadowFactor = inShadow ? SHADOW_AMBIENT : 1.0;

    vec3 halfDir = normalize(lDir + viewDir);
    float spec = pow(max(dot(normal, halfDir), 0.0), SPECULAR_POWER);

    vec3 diffuse = albedo * lightColor * diff * light.intensity * shadowFactor;
    vec3 specular = lightColor * spec * light.intensity * shadowFactor;

    return diffuse + specular;
}

vec3 calculatePointLight(vec3 albedo, vec3 normal, vec3 viewDir, vec3 hitPoint, Light light) {
    vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);
    vec3 lightPos = vec3(light.posX, light.posY, light.posZ);

    vec3 lightVec = lightPos - hitPoint;
    float dist = length(lightVec);
    vec3 lDir = lightVec / dist;

    float attenuation = 1.0 / (1.0 + 0.09 * dist + 0.032 * dist * dist);
    float diff = max(dot(normal, lDir), 0.0);

    bool inShadow = traceShadowBVH(hitPoint + normal * SHADOW_BIAS, lDir, dist);
    float shadowFactor = inShadow ? SHADOW_AMBIENT : 1.0;

    vec3 halfDir = normalize(lDir + viewDir);
    float spec = pow(max(dot(normal, halfDir), 0.0), SPECULAR_POWER);

    vec3 diffuse = albedo * lightColor * diff * light.intensity * attenuation * shadowFactor;
    vec3 specular = lightColor * spec * light.intensity * attenuation * shadowFactor;

    return diffuse + specular;
}

vec3 shade(Hit hit, vec3 rayDir) {
    vec3 albedo = hit.color;
    vec3 result = vec3(0.0);

    vec3 viewDir = -rayDir;
    vec3 normal = hit.normal;
    if (dot(normal, viewDir) < 0.0) {
        normal = -normal;
    }

    int numLights = lighting.numLights;

    for (int i = 0; i < numLights; i++) {
        Light light = lighting.lights[i];

        if (light.type == 0) {
            result += calculateAmbientLight(albedo, light);
        }
        else if (light.type == 1) {
            result += calculateDirectionalLight(albedo, normal, viewDir, hit.point, light);
        }
        else if (light.type == 2) {
            result += calculatePointLight(albedo, normal, viewDir, hit.point, light);
        }
    }

    return clamp(result, 0.0, 1.0);
}

Ray generateRay(ivec2 pixelCoords) {
    vec2 uv = (vec2(pixelCoords) / camera.resolution) * 2.0 - 1.0;
    uv.y = -uv.y;
    uv.x *= s_aspectRatio;

    vec3 rayDir = normalize(s_camForward + s_camRight * uv.x * s_tanHalfFov + s_camUp * uv.y * s_tanHalfFov);

    Ray ray;
    ray.origin = s_camPos;
    ray.direction = rayDir;
    return ray;
}

vec3 getSkyColor(vec3 rayDir) {
    return mix(vec3(0.1, 0.1, 0.15), vec3(0.5, 0.7, 1.0), rayDir.y * 0.5 + 0.5);
}

vec3 calculateReflections(Hit initialHit, vec3 initialRayDir) {
    vec3 reflectionColor = vec3(0.0);

    if (settings.enableReflections == 0 || settings.maxBounces == 0) {
        return reflectionColor;
    }

    Hit hit = initialHit;
    vec3 rayDir = initialRayDir;

    for (int bounce = 0; bounce < settings.maxBounces; bounce++) {
        vec3 reflDir = reflect(rayDir, hit.normal);

        Ray reflRay;
        reflRay.origin = hit.point + hit.normal * SHADOW_BIAS;
        reflRay.direction = reflDir;

        Hit reflHit = traceBVH(reflRay);

        if (reflHit.hit) {
            vec3 reflColor = shade(reflHit, reflDir);

            float fresnel = pow(1.0 - max(dot(-rayDir, hit.normal), 0.0), 5.0);
            float reflectionFactor = settings.reflectionStrength * (0.2 + 0.8 * fresnel);
            float bounceFalloff = pow(0.5, float(bounce + 1));

            reflectionColor += reflColor * reflectionFactor * bounceFalloff;

            rayDir = reflDir;
            hit = reflHit;
        } else {
            break;
        }
    }

    return reflectionColor;
}

vec3 applyGammaCorrection(vec3 color) {
    return pow(color, vec3(1.0 / GAMMA));
}

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    if (gl_LocalInvocationIndex == 0) {
        s_camPos = camera.position;
        s_camForward = normalize(camera.target - camera.position);
        vec3 worldUp = vec3(0.0, 1.0, 0.0);
        s_camRight = normalize(cross(s_camForward, worldUp));
        s_camUp = normalize(cross(s_camRight, s_camForward));
        s_tanHalfFov = tan(camera.fov * 0.5);
        s_aspectRatio = camera.resolution.x / camera.resolution.y;
    }
    barrier();

    if (pixelCoords.x >= int(camera.resolution.x) || pixelCoords.y >= int(camera.resolution.y)) {
        return;
    }

    Ray ray = generateRay(pixelCoords);
    Hit hit = traceBVH(ray);

    vec3 color;

    if (hit.hit) {
        color = shade(hit, ray.direction);
        color += calculateReflections(hit, ray.direction);
    } else {
        color = getSkyColor(ray.direction);
    }

    color = applyGammaCorrection(color);

    imageStore(outputImage, pixelCoords, vec4(color.bgr, 1.0));
}
