#version 450

layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform writeonly image2D outputImage;

layout(binding = 1) uniform CameraUBO {
    vec3 position;
    float _pad1;
    vec3 target;
    float _pad2;
    vec2 resolution;
    float time;
    float fov;
} camera;

struct Triangle {
    vec3 v0;
    float pad0;
    vec3 v1;
    float pad1;
    vec3 v2;
    float pad2;
    vec3 color;
    float pad3;
};

layout(std140, binding = 2) readonly buffer TriangleSSBO {
    Triangle triangles[];
};

struct Light {
    int type;
    float intensity;
    float pad1;
    float pad2;
    float posX;
    float posY;
    float posZ;
    float pad3;
    float dirX;
    float dirY;
    float dirZ;
    float pad4;
    float colorR;
    float colorG;
    float colorB;
    float pad5;
};

layout (std430, binding = 3) buffer LightUBO {
    int numLights;
    int _pad1;
    int _pad2;
    int _pad3;
    Light lights[8];
} lighting;

layout(binding = 4) uniform RenderSettings {
    int maxBounces;
    int enableShadows;
    int enableReflections;
    float reflectionStrength;
    int shadowSamples;
    float shadowSoftness;
    vec2 _pad;
} settings;

struct Ray {
    vec3 origin;
    vec3 direction;
};

struct Hit {
    bool hit;
    float dist;
    vec3 point;
    vec3 normal;
    vec3 color;
};

const float EPSILON = 0.01;
const float MAX_DIST = 100.0;

Hit intersectTriangle(Ray ray, Triangle tri) {
    Hit h;
    h.hit = false;
    
    vec3 e1 = tri.v1 - tri.v0;
    vec3 e2 = tri.v2 - tri.v0;
    vec3 pvec = cross(ray.direction, e2);
    float det = dot(e1, pvec);

    // Backface Culling: ignoriere Rückseiten (det < 0)
    if (det < EPSILON) return h;
    
    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - tri.v0;
    float u = dot(tvec, pvec) * invDet;
    
    if (u < 0.0 || u > 1.0) return h;
    
    vec3 qvec = cross(tvec, e1);
    float v = dot(ray.direction, qvec) * invDet;
    
    if (v < 0.0 || u + v > 1.0) return h;
    
    float t = dot(e2, qvec) * invDet;
    
    if (t > EPSILON) {
        h.hit = true;
        h.dist = t;
        h.point = ray.origin + ray.direction * t;
        h.normal = normalize(cross(e1, e2));
        h.color = tri.color;
    }
    
    return h;
}

Hit intersectTriangleShadow(Ray ray, Triangle tri) {
    Hit h;
    h.hit = false;

    vec3 e1 = tri.v1 - tri.v0;
    vec3 e2 = tri.v2 - tri.v0;
    vec3 pvec = cross(ray.direction, e2);
    float det = dot(e1, pvec);

    // Invertiertes Backface Culling für Schatten - Shadow-Ray kommt von der anderen Seite
    if (det > -EPSILON) return h;

    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - tri.v0;
    float u = dot(tvec, pvec) * invDet;

    if (u < 0.0 || u > 1.0) return h;

    vec3 qvec = cross(tvec, e1);
    float v = dot(ray.direction, qvec) * invDet;

    if (v < 0.0 || u + v > 1.0) return h;

    float t = dot(e2, qvec) * invDet;

    if (t > EPSILON) {
        h.hit = true;
        h.dist = t;
    }

    return h;
}

Hit trace(Ray ray, int numTriangles) {
    Hit closest;
    closest.hit = false;
    closest.dist = MAX_DIST;
    
    for (int i = 0; i < numTriangles; i++) {
        Hit h = intersectTriangle(ray, triangles[i]);
        if (h.hit && h.dist < closest.dist) {
            closest = h;
        }
    }
    
    return closest;
}

float random(vec2 co) {
    return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
}

vec3 randomInUnitDisk(vec2 seed) {
    float angle = random(seed) * 2.0 * 3.14159265;
    float radius = sqrt(random(seed + vec2(1.0, 0.0)));
    return vec3(cos(angle) * radius, sin(angle) * radius, 0.0);
}

Hit traceShadowRay(Ray ray, int numTriangles) {
    Hit closest;
    closest.hit = false;
    closest.dist = MAX_DIST;

    for (int i = 0; i < numTriangles; i++) {
        Hit h = intersectTriangleShadow(ray, triangles[i]);
        if (h.hit && h.dist < closest.dist) {
            closest = h;
        }
    }

    return closest;
}

float traceShadow(vec3 origin, vec3 lightDir, float maxDist, int numTriangles) {
    if (settings.enableShadows == 0) {
        return 1.0;
    }

    if (settings.shadowSamples <= 1) {
        Ray shadowRay;
        shadowRay.origin = origin;
        shadowRay.direction = lightDir;
        Hit shadowHit = traceShadowRay(shadowRay, numTriangles);
        return (shadowHit.hit && shadowHit.dist < maxDist) ? 0.1 : 1.0;
    }

    float shadowFactor = 0.0;
    vec3 tangent = abs(lightDir.y) < 0.9 ? cross(lightDir, vec3(0, 1, 0)) : cross(lightDir, vec3(1, 0, 0));
    tangent = normalize(tangent);
    vec3 bitangent = cross(lightDir, tangent);

    for (int i = 0; i < settings.shadowSamples; i++) {
        vec2 seed = vec2(float(i) * 0.1, camera.time);
        vec3 offset = randomInUnitDisk(seed + gl_GlobalInvocationID.xy * 0.01);
        vec3 sampleDir = normalize(lightDir + (tangent * offset.x + bitangent * offset.y) * settings.shadowSoftness);

        Ray shadowRay;
        shadowRay.origin = origin;
        shadowRay.direction = sampleDir;
        Hit shadowHit = traceShadowRay(shadowRay, numTriangles);

        if (!shadowHit.hit || shadowHit.dist >= maxDist) {
            shadowFactor += 1.0;
        }
    }

    shadowFactor /= float(settings.shadowSamples);
    return mix(0.1, 1.0, shadowFactor);
}

vec3 shade(Hit hit, vec3 rayDir, int numTriangles) {
    vec3 color = hit.color;
    vec3 result = vec3(0.0);

    vec3 viewDir = -rayDir;
    vec3 normal = hit.normal;
    if (dot(normal, viewDir) < 0.0) {
        normal = -normal;
    }

    int numLights = lighting.numLights;

    // Beleuchtung aktiv

    for (int i = 0; i < numLights; i++) {
        Light light = lighting.lights[i];
        vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);
        vec3 lightPos = vec3(light.posX, light.posY, light.posZ);
        vec3 lightDir = vec3(light.dirX, light.dirY, light.dirZ);

        if (light.type == 0) {
            result += color * lightColor * light.intensity;
        }
        else if (light.type == 1) {
            vec3 lDir = normalize(-lightDir);
            float diff = max(dot(normal, lDir), 0.0);

            float shadow = traceShadow(hit.point + normal * EPSILON * 10.0, lDir, MAX_DIST, numTriangles);

            vec3 halfDir = normalize(lDir + viewDir);
            float spec = pow(max(dot(normal, halfDir), 0.0), 32.0);

            result += color * lightColor * diff * light.intensity * shadow;
            result += lightColor * spec * light.intensity * shadow;
        }
        else if (light.type == 2) {
            vec3 lightVec = lightPos - hit.point;
            float dist = length(lightVec);
            vec3 lDir = lightVec / dist;

            float attenuation = 1.0 / (1.0 + 0.09 * dist + 0.032 * dist * dist);

            float diff = max(dot(normal, lDir), 0.0);

            float shadow = traceShadow(hit.point + normal * EPSILON * 10.0, lDir, dist, numTriangles);

            vec3 halfDir = normalize(lDir + viewDir);
            float spec = pow(max(dot(normal, halfDir), 0.0), 32.0);

            result += color * lightColor * diff * light.intensity * attenuation * shadow;
            result += lightColor * spec * light.intensity * attenuation * shadow;
        }
    }

    return clamp(result, 0.0, 1.0);
}


void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    vec2 resolution = camera.resolution;
    
    if (pixelCoords.x >= int(resolution.x) || pixelCoords.y >= int(resolution.y)) {
        return;
    }
    
    vec2 uv = (vec2(pixelCoords) / resolution) * 2.0 - 1.0;
    uv.y = -uv.y;
    uv.x *= resolution.x / resolution.y;

    vec3 forward = normalize(camera.target - camera.position);
    vec3 up = vec3(0, 1, 0);
    vec3 right = normalize(cross(forward, up));
    
    vec3 rayDir = normalize(forward + right * uv.x * tan(camera.fov * 0.5) + up * uv.y * tan(camera.fov * 0.5));
    
    Ray ray;
    ray.origin = camera.position;
    ray.direction = rayDir;
    
    int numTriangles = triangles.length();
    Hit hit = trace(ray, numTriangles);
    
    vec3 color = vec3(0.2, 0.3, 0.5);

    if (hit.hit) {
        color = shade(hit, rayDir, numTriangles);

        if (settings.enableReflections > 0 && settings.maxBounces > 0) {
            for (int bounce = 0; bounce < settings.maxBounces; bounce++) {
                vec3 reflDir = reflect(rayDir, hit.normal);
                ray.origin = hit.point + hit.normal * EPSILON * 10.0;
                ray.direction = reflDir;

                Hit reflHit = trace(ray, numTriangles);

                if (reflHit.hit) {
                    vec3 reflColor = shade(reflHit, reflDir, numTriangles);
                    float fresnel = pow(1.0 - max(dot(-rayDir, hit.normal), 0.0), 5.0);
                    float reflectionFactor = settings.reflectionStrength * (0.2 + 0.8 * fresnel);

                    color += reflColor * reflectionFactor * pow(0.5, float(bounce + 1));

                    rayDir = reflDir;
                    hit = reflHit;
                } else {
                    break;
                }
            }
        }
    } else {
        color = mix(vec3(0.1, 0.1, 0.15), vec3(0.5, 0.7, 1.0), rayDir.y * 0.5 + 0.5);
    }

    color = pow(color, vec3(1.0 / 1.5));

    imageStore(outputImage, pixelCoords, vec4(color.bgr, 1.0));
}
