#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba32f) uniform readonly image2D gPosition;
layout (binding = 1, rgba32f) uniform readonly image2D gNormal;
layout (binding = 2, rgba32f) uniform readonly image2D gAlbedo;
layout (binding = 3, rgba32f) uniform readonly image2D gRayDir;
layout (binding = 4, rgba32f) uniform writeonly image2D litColor;

struct Light {
    int type;
    float intensity;
    float shadowSoftness;
    float pad1;
    float posX;
    float posY;
    float posZ;
    float pad2;
    float dirX;
    float dirY;
    float dirZ;
    float pad3;
    float colorR;
    float colorG;
    float colorB;
    float pad4;
};

layout (std430, binding = 5) buffer LightUBO {
    int numLights;
    int _pad1;
    int _pad2;
    int _pad3;
    Light lights[8];
} lighting;

struct Triangle {
    vec3 v0;
    float pad0;
    vec3 v1;
    float pad1;
    vec3 v2;
    float pad2;
    vec3 color;
    float transparency;
    vec3 n0;
    float ior;
    vec3 n1;
    float reflectivity;
    vec3 n2;
    float enableSchlieren;
};

layout (std140, binding = 6) readonly buffer TriangleSSBO {
    Triangle triangles[];
};

layout (binding = 7) uniform RenderSettings {
    int maxBounces;
    int enableShadows;
    int enableReflections;
    float reflectionStrength;
    int shadowSamples;
    int enableGI;
    int giSamples;
    float giStrength;
    int enableHdr;
    float exposure;
    float gamma;
    int toneMapping;
    float hdrMinNits;
    float hdrMaxNits;
    float _pad0;
    float _pad1;
} settings;

layout (binding = 8) uniform CameraUBO {
    vec3 position;
    float _pad1;
    vec3 target;
    float _pad2;
    vec2 resolution;
    float time;
    float fov;
} camera;

struct BvhNode {
    vec3 boundsMin;
    int leftChild;
    vec3 boundsMax;
    int rightChild;
    int triangleStart;
    int triangleCount;
    int pad0;
    int pad1;
};

layout (std430, binding = 9) readonly buffer BvhSSBO {
    BvhNode bvhNodes[];
};

struct Ray {
    vec3 origin;
    vec3 direction;
};

const float EPSILON = 0.01;
const float MAX_DIST = 100.0;
const float SHADOW_BIAS = 0.1;
const float SPECULAR_POWER = 32.0;
const float SHADOW_AMBIENT = 0.15;
const float PI = 3.14159265;

const vec2 POISSON_DISK[8] = vec2[](
vec2(-0.94201624, -0.39906216),
vec2(0.94558609, -0.76890725),
vec2(-0.094184101, -0.92938870),
vec2(0.34495938, 0.29387760),
vec2(-0.91588581, 0.45771432),
vec2(-0.38277543, 0.27676845),
vec2(0.44323325, -0.97511554),
vec2(0.79197514, 0.19090188)
);

bool intersectTriangleShadow(vec3 origin, vec3 dir, Triangle tri, float maxDist) {
    vec3 e1 = tri.v1 - tri.v0;
    vec3 e2 = tri.v2 - tri.v0;
    vec3 pvec = cross(dir, e2);
    float det = dot(e1, pvec);

    if (det > -1e-6) return false;

    float invDet = 1.0 / det;
    vec3 tvec = origin - tri.v0;
    float u = dot(tvec, pvec) * invDet;

    if (u < 0.0 || u > 1.0) return false;

    vec3 qvec = cross(tvec, e1);
    float v = dot(dir, qvec) * invDet;

    if (v < 0.0 || u + v > 1.0) return false;

    float t = dot(e2, qvec) * invDet;
    return t > EPSILON && t < maxDist;
}

bool intersectAABB(vec3 origin, vec3 invDir, vec3 boxMin, vec3 boxMax, float tMax) {
    vec3 t0s = (boxMin - origin) * invDir;
    vec3 t1s = (boxMax - origin) * invDir;

    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger = max(t0s, t1s);

    float tmin = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    float tmax = min(min(tbigger.x, tbigger.y), tbigger.z);

    return tmax >= max(tmin, 0.0) && tmin < tMax;
}

bool traceShadowBVH(vec3 origin, vec3 lightDir, float maxDist) {
    int numNodes = bvhNodes.length();
    if (numNodes == 0) return false;

    vec3 invDir = 1.0 / lightDir;

    int stack[24];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        BvhNode node = bvhNodes[nodeIdx];

        if (!intersectAABB(origin, invDir, node.boundsMin, node.boundsMax, maxDist)) {
            continue;
        }

        if (node.triangleCount > 0) {
            for (int i = 0; i < node.triangleCount; i++) {
                int triIdx = node.triangleStart + i;
                if (intersectTriangleShadow(origin, lightDir, triangles[triIdx], maxDist)) {
                    return true;
                }
            }
        } else {
            if (node.leftChild >= 0 && stackPtr < 23) {
                stack[stackPtr++] = node.leftChild;
            }
            if (node.rightChild >= 0 && stackPtr < 23) {
                stack[stackPtr++] = node.rightChild;
            }
        }
    }

    return false;
}

float traceSoftShadow(vec3 origin, vec3 lightDir, float maxDist, float softness, ivec2 pixelCoords) {
    if (settings.enableShadows == 0) return 1.0;

    int numSamples = clamp(settings.shadowSamples, 1, 8);

    if (softness < 0.001 || numSamples <= 1) {
        return traceShadowBVH(origin, lightDir, maxDist) ? SHADOW_AMBIENT : 1.0;
    }

    vec3 tangent = abs(lightDir.y) < 0.999
    ? normalize(cross(vec3(0.0, 1.0, 0.0), lightDir))
    : normalize(cross(vec3(1.0, 0.0, 0.0), lightDir));
    vec3 bitangent = cross(lightDir, tangent);

    float shadowSum = 0.0;
    float rotation = float((pixelCoords.x * 73 + pixelCoords.y * 127) & 0xFF) * (PI / 128.0);
    float cosRot = cos(rotation);
    float sinRot = sin(rotation);

    for (int i = 0; i < numSamples; i++) {
        vec2 offset = POISSON_DISK[i] * softness;
        vec2 rotated = vec2(offset.x * cosRot - offset.y * sinRot, offset.x * sinRot + offset.y * cosRot);
        vec3 jitteredDir = normalize(lightDir + tangent * rotated.x + bitangent * rotated.y);

        if (traceShadowBVH(origin, jitteredDir, maxDist)) {
            shadowSum += 1.0;
        }
    }

    return mix(SHADOW_AMBIENT, 1.0, 1.0 - shadowSum / float(numSamples));
}

vec3 shade(vec3 albedo, vec3 normal, vec3 viewDir, vec3 hitPoint, ivec2 pixelCoords) {
    vec3 result = vec3(0.0);

    const float LIGHT_SCALE = 0.5;

    int numLights = min(lighting.numLights, 8);

    for (int i = 0; i < numLights; i++) {
        Light light = lighting.lights[i];
        vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);
        float scaledIntensity = light.intensity * LIGHT_SCALE;

        if (light.type == 0) {
            continue;
        }
        else if (light.type == 1) {
            vec3 lDir = normalize(- vec3(light.dirX, light.dirY, light.dirZ));
            float diff = max(dot(normal, lDir), 0.0);
            float shadow = traceSoftShadow(hitPoint + normal * SHADOW_BIAS, lDir, MAX_DIST, light.shadowSoftness, pixelCoords);

            vec3 halfDir = normalize(lDir + viewDir);
            float spec = pow(max(dot(normal, halfDir), 0.0), SPECULAR_POWER);

            result += (albedo * diff + vec3(spec)) * lightColor * scaledIntensity * shadow;
        }
        else if (light.type == 2) {
            vec3 lightPos = vec3(light.posX, light.posY, light.posZ);
            vec3 lightVec = lightPos - hitPoint;
            float dist = length(lightVec);
            vec3 lDir = lightVec / dist;

            float attenuation = 1.0 / (1.0 + 0.3 * dist + 0.15 * dist * dist);
            float diff = max(dot(normal, lDir), 0.0);
            float shadow = traceSoftShadow(hitPoint + normal * SHADOW_BIAS, lDir, dist, light.shadowSoftness, pixelCoords);

            vec3 halfDir = normalize(lDir + viewDir);
            float spec = pow(max(dot(normal, halfDir), 0.0), SPECULAR_POWER);

            result += (albedo * diff + vec3(spec)) * lightColor * scaledIntensity * attenuation * shadow;
        }
    }

    return clamp(result, 0.0, 1.0);
}

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    if (pixelCoords.x >= int(camera.resolution.x) || pixelCoords.y >= int(camera.resolution.y)) {
        return;
    }

    vec4 posData = imageLoad(gPosition, pixelCoords);
    float isHit = posData.w;

    vec3 color;
    if (isHit > 0.5) {
        vec4 normalData = imageLoad(gNormal, pixelCoords);
        vec4 albedoData = imageLoad(gAlbedo, pixelCoords);
        vec4 rayDirData = imageLoad(gRayDir, pixelCoords);

        vec3 hitPoint = posData.xyz;
        vec3 normal = normalData.xyz;
        vec3 albedo = albedoData.xyz;
        vec3 rayDir = rayDirData.xyz;

        vec3 viewDir = -rayDir;
        if (dot(normal, viewDir) < 0.0) normal = -normal;

        color = shade(albedo, normal, viewDir, hitPoint, pixelCoords);
    } else {
        vec4 albedoData = imageLoad(gAlbedo, pixelCoords);
        color = albedoData.xyz;
    }

    imageStore(litColor, pixelCoords, vec4(color, isHit));
}
