#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba32f) uniform readonly image2D gPosition;
layout (binding = 1, rgba32f) uniform readonly image2D gNormal;
layout (binding = 2, rgba32f) uniform readonly image2D gAlbedo;
layout (binding = 3, rgba32f) uniform readonly image2D gRayDir;
layout (binding = 4, rgba32f) uniform writeonly image2D litColor;

struct Light {
    int type;
    float intensity;
    float shadowSoftness;
    float pad1;
    float posX;
    float posY;
    float posZ;
    float pad2;
    float dirX;
    float dirY;
    float dirZ;
    float pad3;
    float colorR;
    float colorG;
    float colorB;
    float pad4;
};

layout (std430, binding = 5) buffer LightUBO {
    int numLights;
    int _pad1;
    int _pad2;
    int _pad3;
    Light lights[8];
} lighting;

struct Triangle {
    vec3 v0;
    float pad0;
    vec3 v1;
    float pad1;
    vec3 v2;
    float pad2;
    vec3 color;
    float pad3;
    vec3 n0;
    float pad4;
    vec3 n1;
    float pad5;
    vec3 n2;
    float pad6;
};

layout (std140, binding = 6) readonly buffer TriangleSSBO {
    Triangle triangles[];
};

layout (binding = 7) uniform RenderSettings {
    int maxBounces;
    int enableShadows;
    int enableReflections;
    float reflectionStrength;
    int shadowSamples;
    int _pad1;
    vec2 _pad2;
} settings;

layout (binding = 8) uniform CameraUBO {
    vec3 position;
    float _pad1;
    vec3 target;
    float _pad2;
    vec2 resolution;
    float time;
    float fov;
} camera;

struct BvhNode {
    vec3 boundsMin;
    int leftChild;
    vec3 boundsMax;
    int rightChild;
    int triangleStart;
    int triangleCount;
    int pad0;
    int pad1;
};

layout (std430, binding = 9) readonly buffer BvhSSBO {
    BvhNode bvhNodes[];
};

struct Ray {
    vec3 origin;
    vec3 direction;
};

struct Hit {
    bool hit;
    float dist;
};

const float EPSILON = 0.01;
const float BACKFACE_EPSILON = 1e-6;
const float MAX_DIST = 100.0;
const float SHADOW_BIAS = EPSILON * 10.0;
const float SPECULAR_POWER = 32.0;
const float SHADOW_AMBIENT = 0.15;

const vec2 POISSON_DISK[16] = vec2[](
vec2(-0.94201624, -0.39906216),
vec2(0.94558609, -0.76890725),
vec2(-0.094184101, -0.92938870),
vec2(0.34495938, 0.29387760),
vec2(-0.91588581, 0.45771432),
vec2(-0.81544232, -0.87912464),
vec2(-0.38277543, 0.27676845),
vec2(0.97484398, 0.75648379),
vec2(0.44323325, -0.97511554),
vec2(0.53742981, -0.47373420),
vec2(-0.26496911, -0.41893023),
vec2(0.79197514, 0.19090188),
vec2(-0.24188840, 0.99706507),
vec2(-0.81409955, 0.91437590),
vec2(0.19984126, 0.78641367),
vec2(0.14383161, -0.14100790)
);

Hit intersectTriangleShadow(Ray ray, Triangle tri) {
    Hit h;
    h.hit = false;

    vec3 e1 = tri.v1 - tri.v0;
    vec3 e2 = tri.v2 - tri.v0;
    vec3 pvec = cross(ray.direction, e2);
    float det = dot(e1, pvec);

    if (det > -BACKFACE_EPSILON) return h;

    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - tri.v0;
    float u = dot(tvec, pvec) * invDet;

    if (u < 0.0 || u > 1.0) return h;

    vec3 qvec = cross(tvec, e1);
    float v = dot(ray.direction, qvec) * invDet;

    if (v < 0.0 || u + v > 1.0) return h;

    float t = dot(e2, qvec) * invDet;

    if (t > EPSILON) {
        h.hit = true;
        h.dist = t;
    }

    return h;
}

bool intersectAABB(vec3 origin, vec3 invDir, vec3 boxMin, vec3 boxMax, float tMax) {
    vec3 t0s = (boxMin - origin) * invDir;
    vec3 t1s = (boxMax - origin) * invDir;

    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger = max(t0s, t1s);

    float tmin = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    float tmax = min(min(tbigger.x, tbigger.y), tbigger.z);

    return tmax >= max(tmin, 0.0) && tmin < tMax;
}

bool traceShadowRayBVH(vec3 origin, vec3 lightDir, float maxDist) {
    int numNodes = bvhNodes.length();
    if (numNodes == 0) {
        return false;
    }

    vec3 invDir = 1.0 / lightDir;

    int stack[32];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        BvhNode node = bvhNodes[nodeIdx];

        if (!intersectAABB(origin, invDir, node.boundsMin, node.boundsMax, maxDist)) {
            continue;
        }

        if (node.triangleCount > 0) {
            Ray shadowRay;
            shadowRay.origin = origin;
            shadowRay.direction = lightDir;

            for (int i = 0; i < node.triangleCount; i++) {
                int triIdx = node.triangleStart + i;
                Hit h = intersectTriangleShadow(shadowRay, triangles[triIdx]);
                if (h.hit && h.dist < maxDist) {
                    return true;
                }
            }
        } else {
            if (node.leftChild >= 0) {
                stack[stackPtr++] = node.leftChild;
            }
            if (node.rightChild >= 0) {
                stack[stackPtr++] = node.rightChild;
            }
        }
    }

    return false;
}

vec3 buildTangentFrame(vec3 normal, out vec3 tangent, out vec3 bitangent) {
    vec3 up = abs(normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    tangent = normalize(cross(up, normal));
    bitangent = cross(normal, tangent);
    return normal;
}

float traceSoftShadow(vec3 origin, vec3 lightDir, float maxDist, float lightSoftness, ivec2 pixelCoords) {
    if (settings.enableShadows == 0) {
        return 1.0;
    }

    int numSamples = clamp(settings.shadowSamples, 1, 16);
    float softness = lightSoftness;

    if (softness < 0.001 || numSamples <= 1) {
        return traceShadowRayBVH(origin, lightDir, maxDist) ? SHADOW_AMBIENT : 1.0;
    }

    vec3 tangent, bitangent;
    buildTangentFrame(lightDir, tangent, bitangent);

    float shadowSum = 0.0;

    float rotation = float((pixelCoords.x * 73 + pixelCoords.y * 127) & 0xFF) * (3.14159265 / 128.0);
    float cosRot = cos(rotation);
    float sinRot = sin(rotation);

    for (int i = 0; i < numSamples; i++) {
        vec2 offset = POISSON_DISK[i] * softness;

        vec2 rotatedOffset = vec2(
        offset.x * cosRot - offset.y * sinRot,
        offset.x * sinRot + offset.y * cosRot
        );

        vec3 jitteredDir = normalize(lightDir + tangent * rotatedOffset.x + bitangent * rotatedOffset.y);

        if (traceShadowRayBVH(origin, jitteredDir, maxDist)) {
            shadowSum += 1.0;
        }
    }

    float shadowFactor = 1.0 - (shadowSum / float(numSamples));
    return mix(SHADOW_AMBIENT, 1.0, shadowFactor);
}

bool traceShadowBVH(vec3 origin, vec3 lightDir, float maxDist) {
    if (settings.enableShadows == 0) {
        return false;
    }

    int numNodes = bvhNodes.length();
    if (numNodes == 0) {
        return false;
    }

    vec3 invDir = 1.0 / lightDir;

    int stack[32];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        BvhNode node = bvhNodes[nodeIdx];

        if (!intersectAABB(origin, invDir, node.boundsMin, node.boundsMax, maxDist)) {
            continue;
        }

        if (node.triangleCount > 0) {
            Ray shadowRay;
            shadowRay.origin = origin;
            shadowRay.direction = lightDir;

            for (int i = 0; i < node.triangleCount; i++) {
                int triIdx = node.triangleStart + i;
                Hit h = intersectTriangleShadow(shadowRay, triangles[triIdx]);
                if (h.hit && h.dist < maxDist) {
                    return true;
                }
            }
        } else {
            if (node.leftChild >= 0) {
                stack[stackPtr++] = node.leftChild;
            }
            if (node.rightChild >= 0) {
                stack[stackPtr++] = node.rightChild;
            }
        }
    }

    return false;
}

vec3 calculateAmbientLight(vec3 albedo, Light light) {
    vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);
    return albedo * lightColor * light.intensity;
}

vec3 calculateDirectionalLight(vec3 albedo, vec3 normal, vec3 viewDir, vec3 hitPoint, Light light, ivec2 pixelCoords) {
    vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);
    vec3 lightDir = vec3(light.dirX, light.dirY, light.dirZ);
    vec3 lDir = normalize(-lightDir);

    float diff = max(dot(normal, lDir), 0.0);

    float shadowFactor = traceSoftShadow(hitPoint + normal * SHADOW_BIAS, lDir, MAX_DIST, light.shadowSoftness, pixelCoords);

    vec3 halfDir = normalize(lDir + viewDir);
    float spec = pow(max(dot(normal, halfDir), 0.0), SPECULAR_POWER);

    vec3 diffuse = albedo * lightColor * diff * light.intensity * shadowFactor;
    vec3 specular = lightColor * spec * light.intensity * shadowFactor;

    return diffuse + specular;
}

vec3 calculatePointLight(vec3 albedo, vec3 normal, vec3 viewDir, vec3 hitPoint, Light light, ivec2 pixelCoords) {
    vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);
    vec3 lightPos = vec3(light.posX, light.posY, light.posZ);

    vec3 lightVec = lightPos - hitPoint;
    float dist = length(lightVec);
    vec3 lDir = lightVec / dist;

    float attenuation = 1.0 / (1.0 + 0.09 * dist + 0.032 * dist * dist);
    float diff = max(dot(normal, lDir), 0.0);

    float shadowFactor = traceSoftShadow(hitPoint + normal * SHADOW_BIAS, lDir, dist, light.shadowSoftness, pixelCoords);

    vec3 halfDir = normalize(lDir + viewDir);
    float spec = pow(max(dot(normal, halfDir), 0.0), SPECULAR_POWER);

    vec3 diffuse = albedo * lightColor * diff * light.intensity * attenuation * shadowFactor;
    vec3 specular = lightColor * spec * light.intensity * attenuation * shadowFactor;

    return diffuse + specular;
}

vec3 shade(vec3 albedo, vec3 normal, vec3 rayDir, vec3 hitPoint, ivec2 pixelCoords) {
    vec3 result = vec3(0.0);

    vec3 viewDir = -rayDir;
    if (dot(normal, viewDir) < 0.0) {
        normal = -normal;
    }

    int numLights = lighting.numLights;

    for (int i = 0; i < numLights; i++) {
        Light light = lighting.lights[i];

        if (light.type == 0) {
            result += calculateAmbientLight(albedo, light);
        }
        else if (light.type == 1) {
            result += calculateDirectionalLight(albedo, normal, viewDir, hitPoint, light, pixelCoords);
        }
        else if (light.type == 2) {
            result += calculatePointLight(albedo, normal, viewDir, hitPoint, light, pixelCoords);
        }
    }

    return clamp(result, 0.0, 1.0);
}

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    if (pixelCoords.x >= int(camera.resolution.x) || pixelCoords.y >= int(camera.resolution.y)) {
        return;
    }

    vec4 posData = imageLoad(gPosition, pixelCoords);
    vec4 normalData = imageLoad(gNormal, pixelCoords);
    vec4 albedoData = imageLoad(gAlbedo, pixelCoords);
    vec4 rayDirData = imageLoad(gRayDir, pixelCoords);

    float isHit = posData.w;

    vec3 color;
    if (isHit > 0.5) {
        vec3 hitPoint = posData.xyz;
        vec3 normal = normalData.xyz;
        vec3 albedo = albedoData.xyz;
        vec3 rayDir = rayDirData.xyz;

        color = shade(albedo, normal, rayDir, hitPoint, pixelCoords);
    } else {
        color = albedoData.xyz;
    }

    imageStore(litColor, pixelCoords, vec4(color, isHit));
}
