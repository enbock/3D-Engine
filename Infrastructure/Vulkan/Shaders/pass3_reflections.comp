#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba32f) uniform readonly image2D gPosition;
layout (binding = 1, rgba32f) uniform readonly image2D gNormal;
layout (binding = 2, rgba32f) uniform readonly image2D gAlbedo;
layout (binding = 3, rgba32f) uniform readonly image2D gRayDir;
layout (binding = 4, rgba32f) uniform readonly image2D litColor;
layout (binding = 5, rgba32f) uniform writeonly image2D reflectedColor;

struct Triangle {
    vec3 v0;
    float pad0;
    vec3 v1;
    float pad1;
    vec3 v2;
    float pad2;
    vec3 color;
    float transparency;
    vec3 n0;
    float ior;
    vec3 n1;
    float reflectivity;
    vec3 n2;
    float enableSchlieren;
    vec2 uv0;
    vec2 uv1;
    vec2 uv2;
    int baseColorTextureId;
    int normalTextureId;
};

layout (std430, binding = 6) readonly buffer TriangleSSBO {
    Triangle triangles[];
};

struct Light {
    int type;
    float intensity;
    float shadowSoftness;
    float attenuationFactor;
    float posX;
    float posY;
    float posZ;
    float pad2;
    float dirX;
    float dirY;
    float dirZ;
    float pad3;
    float colorR;
    float colorG;
    float colorB;
    float pad4;
};

layout (std430, binding = 7) buffer LightUBO {
    int numLights;
    int _pad1;
    int _pad2;
    int _pad3;
    Light lights[8];
} lighting;

layout (binding = 8) uniform RenderSettings {
    int maxBounces;
    int enableShadows;
    int enableReflections;
    float reflectionStrength;
    int shadowSamples;
    int enableGI;
    int giSamples;
    float giStrength;
    int enableHdr;
    float exposure;
    float gamma;
    int toneMapping;
    float hdrMinNits;
    float hdrMaxNits;
    float _pad0;
    float _pad1;
} settings;

layout (binding = 9) uniform CameraUBO {
    vec3 position;
    float _pad1;
    vec3 target;
    float _pad2;
    vec2 resolution;
    float time;
    float fov;
} camera;

struct BvhNode {
    vec3 boundsMin;
    int leftChild;
    vec3 boundsMax;
    int rightChild;
    int triangleStart;
    int triangleCount;
    int pad0;
    int pad1;
};

layout (std430, binding = 10) readonly buffer BvhSSBO {
    BvhNode bvhNodes[];
};

struct Ray {
    vec3 origin;
    vec3 direction;
};

struct Hit {
    bool hit;
    float dist;
    vec3 point;
    vec3 normal;
    vec3 color;
    float transparency;
    float ior;
    float reflectivity;
};

const float EPSILON = 0.01;
const float BACKFACE_EPSILON = 1e-6;
const float MAX_DIST = 100.0;
const float SHADOW_BIAS = EPSILON * 10.0;
const float SPECULAR_POWER = 32.0;
const float SHADOW_AMBIENT = 0.001;
const float LIGHT_SCALE = 0.75;

const float DISPERSION_STRENGTH = 0.02;
const float CAUCHY_B = 0.004;

const float PHOTON_GATHER_RADIUS = 0.3;

const float SCHLIEREN_STRENGTH = 0.08;
const float SCHLIEREN_FREQUENCY = 2.0;

const float MIN_CONTRIBUTION = 0.01;

const vec2 POISSON_DISK[16] = vec2[](
vec2(-0.94201624, -0.39906216),
vec2(0.94558609, -0.76890725),
vec2(-0.094184101, -0.92938870),
vec2(0.34495938, 0.29387760),
vec2(-0.91588581, 0.45771432),
vec2(-0.81544232, -0.87912464),
vec2(-0.38277543, 0.27676845),
vec2(0.97484398, 0.75648379),
vec2(0.44323325, -0.97511554),
vec2(0.53742981, -0.47373420),
vec2(-0.26496911, -0.41893023),
vec2(0.79197514, 0.19090188),
vec2(-0.24188840, 0.99706507),
vec2(-0.81409955, 0.91437590),
vec2(0.19984126, 0.78641367),
vec2(0.14383161, -0.14100790)
);

Hit intersectTriangle(Ray ray, Triangle tri) {
    Hit h;
    h.hit = false;

    vec3 e1 = tri.v1 - tri.v0;
    vec3 e2 = tri.v2 - tri.v0;
    vec3 pvec = cross(ray.direction, e2);
    float det = dot(e1, pvec);

    if (det < BACKFACE_EPSILON) return h;

    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - tri.v0;
    float u = dot(tvec, pvec) * invDet;

    if (u < 0.0 || u > 1.0) return h;

    vec3 qvec = cross(tvec, e1);
    float v = dot(ray.direction, qvec) * invDet;

    if (v < 0.0 || u + v > 1.0) return h;

    float t = dot(e2, qvec) * invDet;

    if (t > EPSILON) {
        h.hit = true;
        h.dist = t;
        h.point = ray.origin + ray.direction * t;
        float w = 1.0 - u - v;
        vec3 interpolatedNormal = normalize(w * tri.n0 + u * tri.n1 + v * tri.n2);
        h.normal = interpolatedNormal;
        h.color = tri.color;
        h.transparency = tri.transparency;
        h.ior = tri.ior;
        h.reflectivity = tri.reflectivity;
    }

    return h;
}

Hit intersectTriangleShadow(Ray ray, Triangle tri) {
    Hit h;
    h.hit = false;

    vec3 e1 = tri.v1 - tri.v0;
    vec3 e2 = tri.v2 - tri.v0;
    vec3 pvec = cross(ray.direction, e2);
    float det = dot(e1, pvec);

    if (det > -BACKFACE_EPSILON) return h;

    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - tri.v0;
    float u = dot(tvec, pvec) * invDet;

    if (u < 0.0 || u > 1.0) return h;

    vec3 qvec = cross(tvec, e1);
    float v = dot(ray.direction, qvec) * invDet;

    if (v < 0.0 || u + v > 1.0) return h;

    float t = dot(e2, qvec) * invDet;

    if (t > EPSILON) {
        h.hit = true;
        h.dist = t;
    }

    return h;
}

bool intersectAABB(vec3 origin, vec3 invDir, vec3 boxMin, vec3 boxMax, float tMax) {
    vec3 t0s = (boxMin - origin) * invDir;
    vec3 t1s = (boxMax - origin) * invDir;

    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger = max(t0s, t1s);

    float tmin = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    float tmax = min(min(tbigger.x, tbigger.y), tbigger.z);

    return tmax >= max(tmin, 0.0) && tmin < tMax;
}

Hit traceBVH(Ray ray) {
    Hit closest;
    closest.hit = false;
    closest.dist = MAX_DIST;

    int numNodes = bvhNodes.length();
    if (numNodes == 0) {
        return closest;
    }

    vec3 invDir = 1.0 / ray.direction;

    int stack[64];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        BvhNode node = bvhNodes[nodeIdx];

        if (!intersectAABB(ray.origin, invDir, node.boundsMin, node.boundsMax, closest.dist)) {
            continue;
        }

        if (node.triangleCount > 0) {
            for (int i = 0; i < node.triangleCount; i++) {
                int triIdx = node.triangleStart + i;
                Hit h = intersectTriangle(ray, triangles[triIdx]);
                if (h.hit && h.dist < closest.dist) {
                    closest = h;
                }
            }
        } else {
            if (node.rightChild >= 0) {
                stack[stackPtr++] = node.rightChild;
            }
            if (node.leftChild >= 0) {
                stack[stackPtr++] = node.leftChild;
            }
        }
    }

    return closest;
}

bool traceShadowBVH(vec3 origin, vec3 lightDir, float maxDist) {
    if (settings.enableShadows == 0) {
        return false;
    }

    int numNodes = bvhNodes.length();
    if (numNodes == 0) {
        return false;
    }

    vec3 invDir = 1.0 / lightDir;

    int stack[32];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        BvhNode node = bvhNodes[nodeIdx];

        if (!intersectAABB(origin, invDir, node.boundsMin, node.boundsMax, maxDist)) {
            continue;
        }

        if (node.triangleCount > 0) {
            Ray shadowRay;
            shadowRay.origin = origin;
            shadowRay.direction = lightDir;

            for (int i = 0; i < node.triangleCount; i++) {
                int triIdx = node.triangleStart + i;
                Hit h = intersectTriangleShadow(shadowRay, triangles[triIdx]);
                if (h.hit && h.dist < maxDist) {
                    return true;
                }
            }
        } else {
            if (node.leftChild >= 0) {
                stack[stackPtr++] = node.leftChild;
            }
            if (node.rightChild >= 0) {
                stack[stackPtr++] = node.rightChild;
            }
        }
    }

    return false;
}


vec3 calculateAmbientLight(vec3 albedo, Light light) {
    return vec3(0.0);
}

vec3 calculateDirectionalLight(vec3 albedo, vec3 normal, vec3 viewDir, vec3 hitPoint, Light light) {
    vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);
    vec3 lightDir = vec3(light.dirX, light.dirY, light.dirZ);
    vec3 lDir = normalize(-lightDir);

    float diff = max(dot(normal, lDir), 0.0);

    bool inShadow = traceShadowBVH(hitPoint + normal * SHADOW_BIAS, lDir, MAX_DIST);
    float shadowFactor = inShadow ? SHADOW_AMBIENT : 1.0;

    vec3 halfDir = normalize(lDir + viewDir);
    float spec = pow(max(dot(normal, halfDir), 0.0), SPECULAR_POWER);

    float scaledIntensity = light.intensity * LIGHT_SCALE;
    vec3 diffuse = albedo * lightColor * diff * scaledIntensity * shadowFactor;
    vec3 specular = lightColor * spec * scaledIntensity * shadowFactor;

    return diffuse + specular;
}

vec3 calculatePointLight(vec3 albedo, vec3 normal, vec3 viewDir, vec3 hitPoint, Light light) {
    vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);
    vec3 lightPos = vec3(light.posX, light.posY, light.posZ);

    vec3 lightVec = lightPos - hitPoint;
    float dist = length(lightVec);
    vec3 lDir = lightVec / dist;

    float attenFactor = light.attenuationFactor;
    float attenuation = 1.0 / (1.0 + 0.3 * attenFactor * dist + 0.15 * attenFactor * dist * dist);
    float diff = max(dot(normal, lDir), 0.0);

    bool inShadow = traceShadowBVH(hitPoint + normal * SHADOW_BIAS, lDir, dist);
    float shadowFactor = inShadow ? SHADOW_AMBIENT : 1.0;

    vec3 halfDir = normalize(lDir + viewDir);
    float spec = pow(max(dot(normal, halfDir), 0.0), SPECULAR_POWER);

    float scaledIntensity = light.intensity * LIGHT_SCALE;
    vec3 diffuse = albedo * lightColor * diff * scaledIntensity * attenuation * shadowFactor;
    vec3 specular = lightColor * spec * scaledIntensity * attenuation * shadowFactor;

    return diffuse + specular;
}

vec3 shade(vec3 albedo, vec3 normal, vec3 rayDir, vec3 hitPoint) {
    vec3 result = vec3(0.0);

    vec3 viewDir = -rayDir;
    if (dot(normal, viewDir) < 0.0) {
        normal = -normal;
    }

    int numLights = lighting.numLights;

    for (int i = 0; i < numLights; i++) {
        Light light = lighting.lights[i];

        if (light.type == 0) {
            result += calculateAmbientLight(albedo, light);
        }
        else if (light.type == 1) {
            result += calculateDirectionalLight(albedo, normal, viewDir, hitPoint, light);
        }
        else if (light.type == 2) {
            result += calculatePointLight(albedo, normal, viewDir, hitPoint, light);
        }
    }

    return clamp(result, 0.0, 1.0);
}

vec3 calculateReflections(vec3 hitPoint, vec3 normal, vec3 rayDir) {
    vec3 reflectionColor = vec3(0.0);

    if (settings.enableReflections == 0 || settings.maxBounces == 0) {
        return reflectionColor;
    }

    vec3 currentPoint = hitPoint;
    vec3 currentNormal = normal;
    vec3 currentRayDir = rayDir;

    for (int bounce = 0; bounce < settings.maxBounces; bounce++) {
        vec3 reflDir = reflect(currentRayDir, currentNormal);

        Ray reflRay;
        reflRay.origin = currentPoint + currentNormal * SHADOW_BIAS;
        reflRay.direction = reflDir;

        Hit reflHit = traceBVH(reflRay);

        if (reflHit.hit) {
            vec3 reflColor = shade(reflHit.color, reflHit.normal, reflDir, reflHit.point);

            float fresnel = 1.0 - max(dot(-currentRayDir, currentNormal), 0.0);
            float reflectionFactor = settings.reflectionStrength * fresnel;
            float bounceFalloff = pow(0.5, float(bounce + 1));

            reflectionColor += reflColor * reflectionFactor * bounceFalloff;

            currentRayDir = reflDir;
            currentPoint = reflHit.point;
            currentNormal = reflHit.normal;
        } else {
            break;
        }
    }

    return reflectionColor;
}

float fresnelSchlick(float cosTheta, float ior) {
    float r0 = (1.0 - ior) / (1.0 + ior);
    r0 = r0 * r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosTheta, 5.0);
}

vec3 getSkyColor(vec3 rayDir) {
    vec3 horizonColor = vec3(0.001, 0.001, 0.01);
    vec3 zenithColor = vec3(0.0, 0.0, 0.3);
    float t = clamp(rayDir.y * 0.5, 0.0, 1.0);
    return mix(horizonColor, zenithColor, t);
}

float cauchyIOR(float baseIOR, float wavelength) {
    return baseIOR + CAUCHY_B / (wavelength * wavelength);
}

vec3 calculateDispersionFast(vec3 hitPoint, vec3 normal, vec3 rayDir, float baseIOR, vec3 tint, ivec2 pixelCoords) {
    bool entering = dot(rayDir, normal) < 0.0;
    vec3 n = entering ? normal : -normal;

    float iorRed = cauchyIOR(baseIOR, 0.65);
    float iorBlue = cauchyIOR(baseIOR, 0.45);
    float iorGreen = baseIOR;

    float etaR = entering ? (1.0 / iorRed) : iorRed;
    float etaG = entering ? (1.0 / iorGreen) : iorGreen;
    float etaB = entering ? (1.0 / iorBlue) : iorBlue;

    vec3 refractR = refract(rayDir, n, etaR);
    vec3 refractG = refract(rayDir, n, etaG);
    vec3 refractB = refract(rayDir, n, etaB);

    if (length(refractG) < 0.001) return vec3(0.0);

    Ray refractRay;
    refractRay.origin = hitPoint - n * SHADOW_BIAS * 2.0;
    refractRay.direction = refractG;

    Hit refractHit = traceBVH(refractRay);

    vec3 baseColor = vec3(0.0);
    if (refractHit.hit) {
        if (refractHit.transparency > 0.5) {
            bool exitEntering = dot(refractG, refractHit.normal) < 0.0;
            vec3 exitN = exitEntering ? refractHit.normal : -refractHit.normal;
            float exitEta = exitEntering ? (1.0 / refractHit.ior) : refractHit.ior;
            vec3 exitDir = refract(refractG, exitN, exitEta);

            if (length(exitDir) > 0.001) {
                Ray exitRay;
                exitRay.origin = refractHit.point - exitN * SHADOW_BIAS * 2.0;
                exitRay.direction = exitDir;
                Hit exitHit = traceBVH(exitRay);

                if (exitHit.hit && exitHit.transparency < 0.5) {
                    baseColor = shade(exitHit.color, exitHit.normal, exitDir, exitHit.point);
                } else {
                    baseColor = getSkyColor(exitDir);
                }
            }
        } else {
            baseColor = shade(refractHit.color, refractHit.normal, refractG, refractHit.point);
        }
    } else {
        baseColor = getSkyColor(refractG);
    }

    float spread = (iorBlue - iorRed) * 2.0;
    vec3 dispersedColor;
    dispersedColor.r = baseColor.r * (1.0 - spread * 0.5);
    dispersedColor.g = baseColor.g;
    dispersedColor.b = baseColor.b * (1.0 + spread * 0.5);

    float pathLength = refractHit.hit ? refractHit.dist : 1.0;
    vec3 absorption = exp(-tint * pathLength * 0.5);

    return dispersedColor * absorption;
}

vec3 calculatePhotonCausticsFast(vec3 hitPoint, vec3 normal, ivec2 pixelCoords) {
    vec3 causticColor = vec3(0.0);

    int numLights = lighting.numLights;
    for (int li = 0; li < numLights; li++) {
        Light light = lighting.lights[li];

        if (light.type != 1 && light.type != 2) continue;

        vec3 lightDir;
        float lightDist;
        vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);

        if (light.type == 1) {
            lightDir = normalize(- vec3(light.dirX, light.dirY, light.dirZ));
            lightDist = MAX_DIST;
        } else {
            vec3 lightPos = vec3(light.posX, light.posY, light.posZ);
            vec3 lightVec = lightPos - hitPoint;
            lightDist = length(lightVec);
            lightDir = lightVec / lightDist;
        }

        Ray photonRay;
        photonRay.origin = hitPoint + normal * SHADOW_BIAS;
        photonRay.direction = lightDir;

        Hit photonHit = traceBVH(photonRay);

        if (photonHit.hit && photonHit.transparency > 0.5 && photonHit.dist < lightDist) {
            float convergence = 1.0 / (1.0 + photonHit.dist * 0.3);
            float iorFocus = (photonHit.ior - 1.0) * 1.5;
            float dotNL = max(dot(normal, lightDir), 0.0);

            causticColor += lightColor * light.intensity * LIGHT_SCALE * convergence * iorFocus * dotNL * 0.25;
        }
    }

    return causticColor;
}

vec3 calculateVolumetricCausticsFast(vec3 rayOrigin, vec3 rayDir, float maxDist) {
    vec3 volumetricColor = vec3(0.0);

    const int VOLUME_SAMPLES = 3;
    float clampedDist = min(maxDist, 4.0);
    float stepSize = clampedDist / float(VOLUME_SAMPLES);

    int numLights = lighting.numLights;
    if (numLights == 0) return volumetricColor;

    for (int i = 0; i < VOLUME_SAMPLES; i++) {
        float t = stepSize * (float(i) + 0.5);
        vec3 samplePos = rayOrigin + rayDir * t;

        for (int li = 0; li < numLights; li++) {
            Light light = lighting.lights[li];
            if (light.type == 0) continue;

            vec3 lightDir;
            float lightDist;
            vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);

            if (light.type == 1) {
                lightDir = normalize(- vec3(light.dirX, light.dirY, light.dirZ));
                lightDist = MAX_DIST;
            } else {
                vec3 lightPos = vec3(light.posX, light.posY, light.posZ);
                vec3 lightVec = lightPos - samplePos;
                lightDist = length(lightVec);
                lightDir = lightVec / lightDist;
            }

            Ray toLightRay;
            toLightRay.origin = samplePos;
            toLightRay.direction = lightDir;

            Hit lightHit = traceBVH(toLightRay);

            if (lightHit.hit && lightHit.transparency > 0.5 && lightHit.dist < lightDist) {
                float attenuation = exp(-t * 0.15);
                float focusFactor = 1.0 + (lightHit.ior - 1.0) * 0.3;

                volumetricColor += lightColor * light.intensity * LIGHT_SCALE * 0.015 * attenuation * focusFactor;
            }
        }
    }

    return volumetricColor;
}

float noise3D(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);

    float n = dot(i, vec3(1.0, 57.0, 113.0));

    return mix(
        mix(
            mix(fract(sin(n) * 43758.5453), fract(sin(n + 1.0) * 43758.5453), f.x),
            mix(fract(sin(n + 57.0) * 43758.5453), fract(sin(n + 58.0) * 43758.5453), f.x),
            f.y
        ),
        mix(
            mix(fract(sin(n + 113.0) * 43758.5453), fract(sin(n + 114.0) * 43758.5453), f.x),
            mix(fract(sin(n + 170.0) * 43758.5453), fract(sin(n + 171.0) * 43758.5453), f.x),
            f.y
        ),
        f.z
    );
}

vec3 calculateSchlieren(vec3 hitPoint, vec3 normal, vec3 rayDir, float time) {
    vec3 distortedNormal = normal;

    vec3 noiseCoord = hitPoint * SCHLIEREN_FREQUENCY + vec3(0.0, time * 0.5, 0.0);

    float noiseX = noise3D(noiseCoord) * 2.0 - 1.0;
    float noiseY = noise3D(noiseCoord + vec3(100.0, 0.0, 0.0)) * 2.0 - 1.0;
    float noiseZ = noise3D(noiseCoord + vec3(0.0, 100.0, 0.0)) * 2.0 - 1.0;

    vec3 distortion = vec3(noiseX, noiseY, noiseZ) * SCHLIEREN_STRENGTH;

    distortedNormal = normalize(normal + distortion);

    return distortedNormal;
}


vec3 calculateRefraction(vec3 hitPoint, vec3 normal, vec3 rayDir, float ior, vec3 tint) {
    vec3 refractionColor = vec3(0.0);

    bool entering = dot(rayDir, normal) < 0.0;
    vec3 n = entering ? normal : -normal;
    float eta = entering ? (1.0 / ior) : ior;

    vec3 refractedDir = refract(rayDir, n, eta);

    if (length(refractedDir) < 0.001) {
        return vec3(0.0);
    }

    Ray refractRay;
    refractRay.origin = hitPoint - n * SHADOW_BIAS * 2.0;
    refractRay.direction = refractedDir;

    Hit refractHit = traceBVH(refractRay);

    if (refractHit.hit) {
        if (refractHit.transparency > 0.5) {
            bool exitEntering = dot(refractedDir, refractHit.normal) < 0.0;
            vec3 exitN = exitEntering ? refractHit.normal : -refractHit.normal;
            float exitEta = exitEntering ? (1.0 / refractHit.ior) : refractHit.ior;

            vec3 exitDir = refract(refractedDir, exitN, exitEta);

            if (length(exitDir) > 0.001) {
                Ray exitRay;
                exitRay.origin = refractHit.point - exitN * SHADOW_BIAS * 2.0;
                exitRay.direction = exitDir;

                Hit exitHit = traceBVH(exitRay);

                if (exitHit.hit && exitHit.transparency < 0.5) {
                    refractionColor = shade(exitHit.color, exitHit.normal, exitDir, exitHit.point);
                } else {
                    refractionColor = getSkyColor(exitDir);
                }
            }
        } else {
            refractionColor = shade(refractHit.color, refractHit.normal, refractedDir, refractHit.point);
        }
    } else {
        refractionColor = getSkyColor(refractedDir);
    }

    float pathLength = refractHit.hit ? refractHit.dist : 1.0;
    vec3 absorption = exp(-tint * pathLength * 0.5);
    refractionColor *= absorption;

    return refractionColor;
}

vec3 calculateCaustics(vec3 hitPoint, vec3 normal, ivec2 pixelCoords) {
    vec3 causticColor = vec3(0.0);

    int numLights = lighting.numLights;
    for (int i = 0; i < numLights; i++) {
        Light light = lighting.lights[i];

        if (light.type != 1 && light.type != 2) continue;

        vec3 lightDir;
        float lightDist;

        if (light.type == 1) {
            lightDir = normalize(- vec3(light.dirX, light.dirY, light.dirZ));
            lightDist = MAX_DIST;
        } else {
            vec3 lightPos = vec3(light.posX, light.posY, light.posZ);
            vec3 lightVec = lightPos - hitPoint;
            lightDist = length(lightVec);
            lightDir = lightVec / lightDist;
        }

        Ray photonRay;
        photonRay.origin = hitPoint + normal * SHADOW_BIAS;
        photonRay.direction = lightDir;

        Hit photonHit = traceBVH(photonRay);

        if (photonHit.hit && photonHit.transparency > 0.5 && photonHit.dist < lightDist) {
            float focusFactor = 1.0 + photonHit.ior * 0.2;
            vec3 lightColor = vec3(light.colorR, light.colorG, light.colorB);

            float dotNL = max(dot(normal, lightDir), 0.0);
            causticColor += lightColor * light.intensity * LIGHT_SCALE * focusFactor * dotNL * 0.3;
        }
    }

    return causticColor;
}

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    if (pixelCoords.x >= int(camera.resolution.x) || pixelCoords.y >= int(camera.resolution.y)) {
        return;
    }

    vec4 posData = imageLoad(gPosition, pixelCoords);
    vec4 normalData = imageLoad(gNormal, pixelCoords);
    vec4 albedoData = imageLoad(gAlbedo, pixelCoords);
    vec4 rayDirData = imageLoad(gRayDir, pixelCoords);
    vec4 litData = imageLoad(litColor, pixelCoords);

    float isHit = posData.w;
    float transparency = normalData.w;
    float ior = albedoData.w;

    float packedReflSchlieren = rayDirData.w;
    float enableSchlieren = floor(packedReflSchlieren / 10.0);
    float reflectivity = packedReflSchlieren - enableSchlieren * 10.0;

    vec3 color = litData.xyz;

    if (isHit > 0.5) {
        vec3 hitPoint = posData.xyz;
        vec3 normal = normalData.xyz;
        vec3 albedo = albedoData.xyz;
        vec3 rayDir = rayDirData.xyz;

        float distToHit = length(hitPoint - camera.position);

        if (transparency > 0.01) {
            vec3 effectiveNormal = normal;
            if (enableSchlieren > 0.5) {
                effectiveNormal = calculateSchlieren(hitPoint, normal, rayDir, camera.time);
            }

            float cosTheta = abs(dot(-rayDir, effectiveNormal));
            float fresnel = fresnelSchlick(cosTheta, ior);

            vec3 reflectionColor = vec3(0.0);
            if (fresnel > MIN_CONTRIBUTION) {
                reflectionColor = calculateReflections(hitPoint, effectiveNormal, rayDir);
            }

            vec3 dispersedColor = vec3(0.0);
            float transmissionFactor = (1.0 - fresnel) * transparency;
            if (transmissionFactor > MIN_CONTRIBUTION) {
                if (ior > 1.8) {
                    dispersedColor = calculateDispersionFast(hitPoint, effectiveNormal, rayDir, ior, vec3(1.0) - albedo, pixelCoords);
                } else {
                    dispersedColor = calculateRefraction(hitPoint, effectiveNormal, rayDir, ior, vec3(1.0) - albedo);
                }
            }

            vec3 surfaceColor = litData.xyz * (1.0 - transparency);

            color = surfaceColor +
            reflectionColor * fresnel * (reflectivity + 0.1) +
            dispersedColor * transmissionFactor;

            if (distToHit < 8.0) {
                vec3 volumetric = calculateVolumetricCausticsFast(camera.position, rayDir, distToHit);
                color += volumetric;
            }
        } else {
            vec3 reflections = calculateReflections(hitPoint, normal, rayDir);
            color += reflections;

            vec3 caustics = calculatePhotonCausticsFast(hitPoint, normal, pixelCoords);
            color += caustics;
        }
    }

    imageStore(reflectedColor, pixelCoords, vec4(color, 1.0));
}
