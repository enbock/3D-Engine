#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba32f) uniform writeonly image2D gPosition;
layout (binding = 1, rgba32f) uniform writeonly image2D gNormal;
layout (binding = 2, rgba32f) uniform writeonly image2D gAlbedo;
layout (binding = 3, rgba32f) uniform writeonly image2D gRayDir;

layout (binding = 4) uniform CameraUBO {
    vec3 position;
    float _pad1;
    vec3 target;
    float _pad2;
    vec2 resolution;
    float time;
    float fov;
} camera;

struct Triangle {
    vec3 v0;
    float pad0;
    vec3 v1;
    float pad1;
    vec3 v2;
    float pad2;
    vec3 color;
    float pad3;
    vec3 n0;
    float pad4;
    vec3 n1;
    float pad5;
    vec3 n2;
    float pad6;
};

layout (std140, binding = 5) readonly buffer TriangleSSBO {
    Triangle triangles[];
};

struct BvhNode {
    vec3 boundsMin;
    int leftChild;
    vec3 boundsMax;
    int rightChild;
    int triangleStart;
    int triangleCount;
    int pad0;
    int pad1;
};

layout (std430, binding = 6) readonly buffer BvhSSBO {
    BvhNode bvhNodes[];
};

shared vec3 s_camPos;
shared vec3 s_camForward;
shared vec3 s_camRight;
shared vec3 s_camUp;
shared float s_tanHalfFov;
shared float s_aspectRatio;

struct Ray {
    vec3 origin;
    vec3 direction;
};

struct Hit {
    bool hit;
    float dist;
    vec3 point;
    vec3 normal;
    vec3 color;
};

const float EPSILON = 0.01;
const float BACKFACE_EPSILON = 1e-6;
const float MAX_DIST = 100.0;

Hit intersectTriangle(Ray ray, Triangle tri) {
    Hit h;
    h.hit = false;

    vec3 e1 = tri.v1 - tri.v0;
    vec3 e2 = tri.v2 - tri.v0;
    vec3 pvec = cross(ray.direction, e2);
    float det = dot(e1, pvec);

    if (det < BACKFACE_EPSILON) return h;

    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - tri.v0;
    float u = dot(tvec, pvec) * invDet;

    if (u < 0.0 || u > 1.0) return h;

    vec3 qvec = cross(tvec, e1);
    float v = dot(ray.direction, qvec) * invDet;

    if (v < 0.0 || u + v > 1.0) return h;

    float t = dot(e2, qvec) * invDet;

    if (t > EPSILON) {
        h.hit = true;
        h.dist = t;
        h.point = ray.origin + ray.direction * t;
        float w = 1.0 - u - v;
        vec3 interpolatedNormal = normalize(w * tri.n0 + u * tri.n1 + v * tri.n2);
        h.normal = interpolatedNormal;
        h.color = tri.color;
    }

    return h;
}

bool intersectAABB(vec3 origin, vec3 invDir, vec3 boxMin, vec3 boxMax, float tMax) {
    vec3 t0s = (boxMin - origin) * invDir;
    vec3 t1s = (boxMax - origin) * invDir;

    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger = max(t0s, t1s);

    float tmin = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    float tmax = min(min(tbigger.x, tbigger.y), tbigger.z);

    return tmax >= max(tmin, 0.0) && tmin < tMax;
}

Hit traceBVH(Ray ray) {
    Hit closest;
    closest.hit = false;
    closest.dist = MAX_DIST;

    int numNodes = bvhNodes.length();
    if (numNodes == 0) {
        return closest;
    }

    vec3 invDir = 1.0 / ray.direction;

    int stack[64];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        BvhNode node = bvhNodes[nodeIdx];

        if (!intersectAABB(ray.origin, invDir, node.boundsMin, node.boundsMax, closest.dist)) {
            continue;
        }

        if (node.triangleCount > 0) {
            for (int i = 0; i < node.triangleCount; i++) {
                int triIdx = node.triangleStart + i;
                Hit h = intersectTriangle(ray, triangles[triIdx]);
                if (h.hit && h.dist < closest.dist) {
                    closest = h;
                }
            }
        } else {
            if (node.rightChild >= 0) {
                stack[stackPtr++] = node.rightChild;
            }
            if (node.leftChild >= 0) {
                stack[stackPtr++] = node.leftChild;
            }
        }
    }

    return closest;
}

Ray generateRay(ivec2 pixelCoords) {
    vec2 uv = (vec2(pixelCoords) / camera.resolution) * 2.0 - 1.0;
    uv.y = -uv.y;
    uv.x *= s_aspectRatio;

    vec3 rayDir = normalize(s_camForward + s_camRight * uv.x * s_tanHalfFov + s_camUp * uv.y * s_tanHalfFov);

    Ray ray;
    ray.origin = s_camPos;
    ray.direction = rayDir;
    return ray;
}

vec3 getSkyColor(vec3 rayDir) {
    return mix(vec3(0.1, 0.1, 0.15), vec3(0.5, 0.7, 1.0), rayDir.y * 0.5 + 0.5);
}

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    if (gl_LocalInvocationIndex == 0) {
        s_camPos = camera.position;
        s_camForward = normalize(camera.target - camera.position);
        vec3 worldUp = vec3(0.0, 1.0, 0.0);
        s_camRight = normalize(cross(s_camForward, worldUp));
        s_camUp = normalize(cross(s_camRight, s_camForward));
        s_tanHalfFov = tan(camera.fov * 0.5);
        s_aspectRatio = camera.resolution.x / camera.resolution.y;
    }
    barrier();

    if (pixelCoords.x >= int(camera.resolution.x) || pixelCoords.y >= int(camera.resolution.y)) {
        return;
    }

    Ray ray = generateRay(pixelCoords);
    Hit hit = traceBVH(ray);

    if (hit.hit) {
        imageStore(gPosition, pixelCoords, vec4(hit.point, 1.0));
        imageStore(gNormal, pixelCoords, vec4(hit.normal, 0.0));
        imageStore(gAlbedo, pixelCoords, vec4(hit.color, 0.0));
        imageStore(gRayDir, pixelCoords, vec4(ray.direction, 0.0));
    } else {
        vec3 skyColor = getSkyColor(ray.direction);
        imageStore(gPosition, pixelCoords, vec4(0.0, 0.0, 0.0, 0.0));
        imageStore(gNormal, pixelCoords, vec4(0.0, 0.0, 0.0, 0.0));
        imageStore(gAlbedo, pixelCoords, vec4(skyColor, 0.0));
        imageStore(gRayDir, pixelCoords, vec4(ray.direction, 0.0));
    }
}
