#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba32f) uniform readonly image2D reflectedColor;
layout (binding = 1, rgba16f) uniform writeonly image2D outputImage;

layout (binding = 2) uniform CameraUBO {
    vec3 position;
    float _pad1;
    vec3 target;
    float _pad2;
    vec2 resolution;
    float time;
    float fov;
} camera;

layout (binding = 3) uniform RenderSettings {
    int maxBounces;
    int enableShadows;
    int enableReflections;
    float reflectionStrength;
    int shadowSamples;
    int enableGI;
    int giSamples;
    float giStrength;
    int enableCaustics;
    int enableHdr;
    float exposure;
    float gamma;
    int toneMapping;
    float hdrMinNits;
    float hdrMaxNits;
    float _pad0;
    float _pad1;
} settings;

const int TONEMAP_NONE = 0;
const int TONEMAP_REINHARD = 1;
const int TONEMAP_ACES = 2;
const int TONEMAP_UNCHARTED2 = 3;

vec3 linearToST2084(vec3 color) {
    float m1 = 0.1593017578125;
    float m2 = 78.84375;
    float c1 = 0.8359375;
    float c2 = 18.8515625;
    float c3 = 18.6875;

    float peakNits = max(settings.hdrMaxNits, 1.0);
    vec3 Y = color * (peakNits / 10000.0);
    Y = clamp(Y, 0.0, 1.0);

    vec3 Ym1 = pow(Y, vec3(m1));
    vec3 numerator = c1 + c2 * Ym1;
    vec3 denominator = 1.0 + c3 * Ym1;

    return pow(numerator / denominator, vec3(m2));
}

vec3 reinhardToneMapping(vec3 color, float exposure) {
    color *= exposure;
    return color / (1.0 + color);
}

vec3 acesFilmicToneMapping(vec3 color, float exposure) {
    color *= exposure;
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((color * (a * color + b)) / (color * (c * color + d) + e), 0.0, 1.0);
}

vec3 uncharted2ToneMapOperator(vec3 x) {
    float A = 0.15;
    float B = 0.50;
    float C = 0.10;
    float D = 0.20;
    float E = 0.02;
    float F = 0.30;
    return ((x * (A * x + C * B) + D * E) / (x * (A * x + B) + D * F)) - E / F;
}

vec3 uncharted2ToneMapping(vec3 color, float exposure) {
    float W = 11.2;
    color *= exposure;
    vec3 curr = uncharted2ToneMapOperator(color);
    vec3 whiteScale = 1.0 / uncharted2ToneMapOperator(vec3(W));
    return curr * whiteScale;
}

vec3 applyToneMapping(vec3 color) {
    float exposure = max(settings.exposure, 0.01);

    if (settings.toneMapping == TONEMAP_REINHARD) {
        return reinhardToneMapping(color, exposure);
    } else if (settings.toneMapping == TONEMAP_ACES) {
        return acesFilmicToneMapping(color, exposure);
    } else if (settings.toneMapping == TONEMAP_UNCHARTED2) {
        return uncharted2ToneMapping(color, exposure);
    }

    return clamp(color * exposure, 0.0, 1.0);
}

vec3 applyGammaCorrection(vec3 color) {
    float gamma = max(settings.gamma, 0.1);
    return pow(color, vec3(1.0 / gamma));
}

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    vec2 resolution = camera.resolution;

    if (pixelCoords.x >= int(resolution.x) || pixelCoords.y >= int(resolution.y)) {
        return;
    }

    vec4 colorData = imageLoad(reflectedColor, pixelCoords);
    vec3 color = colorData.xyz;

    color = applyToneMapping(color);

    if (settings.enableHdr != 0) {
        color = linearToST2084(color);
    } else {
        color = applyGammaCorrection(color);
    }

    imageStore(outputImage, pixelCoords, vec4(color, 1.0));
}
