#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba32f) uniform readonly image2D gPosition;
layout (binding = 1, rgba32f) uniform readonly image2D gNormal;
layout (binding = 2, rgba32f) uniform readonly image2D gAlbedo;
layout (binding = 3, rgba32f) uniform readonly image2D litColor;
layout (binding = 4, rgba32f) uniform writeonly image2D downsampledShadow0;
layout (binding = 5, rgba32f) uniform writeonly image2D downsampledShadow1;

struct Light {
    int type;
    float intensity;
    float shadowSoftness;
    float attenuationFactor;
    float posX;
    float posY;
    float posZ;
    float pad2;
    float dirX;
    float dirY;
    float dirZ;
    float pad3;
    float colorR;
    float colorG;
    float colorB;
    float pad4;
};

struct Triangle {
    vec3 v0;
    float pad0;
    vec3 v1;
    float pad1;
    vec3 v2;
    float pad2;
    vec3 color;
    float transparency;
    vec3 n0;
    float ior;
    vec3 n1;
    float reflectivity;
    vec3 n2;
    float enableSchlieren;
    vec2 uv0;
    vec2 uv1;
    vec2 uv2;
    int baseColorTextureId;
    int normalTextureId;
};

struct BvhNode {
    vec3 boundsMin;
    int leftChild;
    vec3 boundsMax;
    int rightChild;
    int triangleStart;
    int triangleCount;
    int pad0;
    int pad1;
};

layout (std430, binding = 6) readonly buffer TriangleSSBO { Triangle triangles[]; };
layout (std430, binding = 7) buffer LightUBO { int numLights; int _pad1; int _pad2; int _pad3; Light lights[8]; } lighting;
layout (binding = 8) uniform RenderSettings { int maxBounces; int enableShadows; int enableReflections; float reflectionStrength; int shadowSamples; int enableGI; int giSamples; float giStrength; int resolutionScale; int giResolutionScale; int shadowResolutionScale; int enableCaustics; int enableHdr; float exposure; float gamma; int toneMapping; float hdrMinNits; float hdrMaxNits; } settings;
layout (binding = 9) uniform CameraUBO { vec3 position; float _pad1; vec3 target; float _pad2; vec2 resolution; float time; float fov; } camera;
layout (std430, binding = 10) readonly buffer BvhSSBO { BvhNode bvhNodes[]; };

const float EPSILON = 0.01;
const float MAX_DIST = 100.0;
const float SHADOW_BIAS = 0.1;
const float SHADOW_AMBIENT = 0.001;
const float PI = 3.14159265;

const vec2 POISSON_DISK[8] = vec2[](
vec2(-0.94201624, -0.39906216),
vec2(0.94558609, -0.76890725),
vec2(-0.094184101, -0.92938870),
vec2(0.34495938, 0.29387760),
vec2(-0.91588581, 0.45771432),
vec2(-0.38277543, 0.27676845),
vec2(0.44323325, -0.97511554),
vec2(0.79197514, 0.19090188)
);

bool intersectTriangleShadow(vec3 origin, vec3 dir, uint triIdx, float maxDist) {
    Triangle tri = triangles[triIdx];
    vec3 e1 = tri.v1 - tri.v0;
    vec3 e2 = tri.v2 - tri.v0;
    vec3 pvec = cross(dir, e2);
    float det = dot(e1, pvec);

    if (det > -1e-6) return false;

    float invDet = 1.0 / det;
    vec3 tvec = origin - tri.v0;
    float u = dot(tvec, pvec) * invDet;

    if (u < 0.0 || u > 1.0) return false;

    vec3 qvec = cross(tvec, e1);
    float v = dot(dir, qvec) * invDet;

    if (v < 0.0 || u + v > 1.0) return false;

    float t = dot(e2, qvec) * invDet;
    return t > EPSILON && t < maxDist;
}

bool intersectAABB(vec3 origin, vec3 invDir, vec3 boxMin, vec3 boxMax, float tMax) {
    vec3 t0s = (boxMin - origin) * invDir;
    vec3 t1s = (boxMax - origin) * invDir;

    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger = max(t0s, t1s);

    float tmin = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    float tmax = min(min(tbigger.x, tbigger.y), tbigger.z);

    return tmax >= max(tmin, 0.0) && tmin < tMax;
}

bool traceShadowBVH(vec3 origin, vec3 lightDir, float maxDist) {
    vec3 invDir = 1.0 / lightDir;

    int stack[24];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        BvhNode node = bvhNodes[nodeIdx];

        if (!intersectAABB(origin, invDir, node.boundsMin, node.boundsMax, maxDist)) {
            continue;
        }

        if (node.triangleCount > 0) {
            for (int i = 0; i < node.triangleCount; i++) {
                int triIdx = node.triangleStart + i;
                if (intersectTriangleShadow(origin, lightDir, uint(triIdx), maxDist)) {
                    return true;
                }
            }
        } else {
            if (node.leftChild >= 0 && stackPtr < 23) {
                stack[stackPtr++] = node.leftChild;
            }
            if (node.rightChild >= 0 && stackPtr < 23) {
                stack[stackPtr++] = node.rightChild;
            }
        }
    }

    return false;
}

float traceSoftShadow(vec3 origin, vec3 lightDir, float maxDist, float softness, ivec2 pixelCoords) {
    if (settings.enableShadows == 0) return 1.0;

    int numSamples = clamp(settings.shadowSamples, 1, 8);

    if (softness < 0.001 || numSamples <= 1) {
        return traceShadowBVH(origin, lightDir, maxDist) ? SHADOW_AMBIENT : 1.0;
    }

    vec3 tangent = abs(lightDir.y) < 0.999
    ? normalize(cross(vec3(0.0, 1.0, 0.0), lightDir))
    : normalize(cross(vec3(1.0, 0.0, 0.0), lightDir));
    vec3 bitangent = cross(lightDir, tangent);

    float shadowSum = 0.0;

    // Static spatial hash for consistent, unobjectionable dithering pattern
    uint seed = uint(pixelCoords.x * 1973 + pixelCoords.y * 9277);
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    float rotation = float(seed & 0xFFFF) * (PI * 2.0 / 65536.0);

    float cosRot = cos(rotation);
    float sinRot = sin(rotation);

    for (int i = 0; i < numSamples; i++) {
        vec2 offset = POISSON_DISK[i] * softness;
        vec2 rotated = vec2(offset.x * cosRot - offset.y * sinRot, offset.x * sinRot + offset.y * cosRot);
        vec3 jitteredDir = normalize(lightDir + tangent * rotated.x + bitangent * rotated.y);

        if (traceShadowBVH(origin, jitteredDir, maxDist)) {
            shadowSum += 1.0;
        }
    }

    return mix(SHADOW_AMBIENT, 1.0, 1.0 - shadowSum / float(numSamples));
}

void main() {
    ivec2 dsCoord = ivec2(gl_GlobalInvocationID.xy);
    int scale = max(1, settings.shadowResolutionScale);

    ivec2 fullRes = ivec2(camera.resolution);
    ivec2 dsRes = (fullRes + ivec2(scale - 1)) / scale;

    if (dsCoord.x >= dsRes.x || dsCoord.y >= dsRes.y) return;

    ivec2 fullCoord = dsCoord * scale;
    if (fullCoord.x >= fullRes.x || fullCoord.y >= fullRes.y) return;

    vec4 posData = imageLoad(gPosition, fullCoord);
    float isHit = posData.w;

    vec4 out0 = vec4(1.0);
    vec4 out1 = vec4(1.0);

    if (isHit > 0.5 && settings.enableShadows != 0) {
        vec3 hitPoint = posData.xyz;
        vec3 normal = imageLoad(gNormal, fullCoord).xyz;

        int numLights = min(lighting.numLights, 8);
        for (int i = 0; i < numLights; i++) {
            float factor = 1.0;
            if (lighting.lights[i].type == 1) {
                vec3 ldir = normalize(- vec3(lighting.lights[i].dirX, lighting.lights[i].dirY, lighting.lights[i].dirZ));
                factor = traceSoftShadow(hitPoint + normal * SHADOW_BIAS, ldir, MAX_DIST, lighting.lights[i].shadowSoftness, fullCoord);
            } else if (lighting.lights[i].type == 2) {
                vec3 lpos = vec3(lighting.lights[i].posX, lighting.lights[i].posY, lighting.lights[i].posZ);
                vec3 toLight = lpos - hitPoint;
                float dist = length(toLight);
                factor = traceSoftShadow(hitPoint + normal * SHADOW_BIAS, normalize(toLight), dist, lighting.lights[i].shadowSoftness, fullCoord);
            }

            if (i < 4) {
                if (i == 0) out0.r = factor;
                if (i == 1) out0.g = factor;
                if (i == 2) out0.b = factor;
                if (i == 3) out0.a = factor;
            } else {
                int idx = i - 4;
                if (idx == 0) out1.r = factor;
                if (idx == 1) out1.g = factor;
                if (idx == 2) out1.b = factor;
                if (idx == 3) out1.a = factor;
            }
        }
    }

    imageStore(downsampledShadow0, dsCoord, out0);
    imageStore(downsampledShadow1, dsCoord, out1);
}
